<project xmlns="http://apache.org" xmlns:xsi="http://w3.org" xsi:schemaLocation="http://apache.org http://apache.org">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.avatar.bending</groupId>
    <artifactId>EarthRidgeAddon</artifactId>
    <version>1.0.0</version>

    <repositories>
        <!-- This repository handles the downloads perfectly -->
        <repository>
            <id>papermc</id>
            <url>https://papermc.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- We swap Spigot for Paper API so the download doesn't fail -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.17.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- Modern ProjectKorra Core inside Maven Central -->
        <dependency>
            <groupId>com.projectkorra</groupId>
            <artifactId>projectkorra</artifactId>
            <version>1.12.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
